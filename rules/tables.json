    "parentNoHouse": { "type": "bool", "label": "부모(와 그 배우자)도 무주택" },
    "realEstate331": { "type": "bool", "label": "세대 부동산 합계 3억 3,100만원 이하" },
    "childAfter20240619": { "type": "bool", "label": "2024-06-19 이후 출생 자녀(태아·입양 포함)" },
